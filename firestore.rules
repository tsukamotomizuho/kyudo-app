rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // チーム：ログイン済みなら誰でも読める・作れる。
    // 作るときは owner が自分の uid であること。
    // 更新・削除は作った本人だけ。
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.owner;
    }

    // メンバー記録：ログイン済みなら誰でも読める（ランキング用）。
    // 書き込み・削除は自分のドキュメントだけ。
    // subscription はサーバー（Admin SDK）だけが書ける。クライアントが
    // 自分で subscription を書き換えて有料プランを名乗るのを防ぐため、
    // create では subscription を含んではならず、update では変更前後で
    // subscription が等しくなければならない。
    // （doShare は set（merge:true）で subscription を含まないため、
    //  他のフィールドの更新は今まで通りできる。）
    match /members/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && !('subscription' in request.resource.data);
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.get('subscription', null) == resource.data.get('subscription', null);
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
